    "verify:invoice-payment-method": "vite-node scripts/verify-invoice-payment-method-uat.mjs",
    "verify:admin-invoice-serving-branch": "vite-node scripts/verify-admin-invoice-serving-branch-uat.mjs",
    "verify:salary-advance": "vite-node scripts/verify-salary-advance.mjs",
